# npm's arborist resolver throws "Cannot read properties of null (reading
# 'edgesOut')" on a plain `npm install` in this repo — a peer-dependency
# resolution bug triggered by @cloudflare/vitest-pool-workers' optional
# peer on @vitest/browser-playwright. legacy-peer-deps sidesteps it.
# Confirmed by direct reproduction, not assumed; see the commit that
# added this file for the exact npm error if it needs revisiting.
legacy-peer-deps=true
