{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vf-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  "compatibility_flags": ["global_fetch_strictly_public"],

  /*
    A hostname in the zone, because **Access cannot protect
    `workers.dev`** — decision 0187.

    Cloudflare Access applies a policy to a hostname in a zone you
    control, so a Worker reachable only at `vf-admin.<subdomain>.workers.dev`
    cannot be put behind it. That address stays reachable and this
    Worker refuses every request arriving there, because no Access
    header is present (decision 0186) — which is the correct answer and
    not a fallback.

    `custom_domain` makes Cloudflare create the DNS record itself, so
    the hostname and the Worker cannot disagree about where it lives.
  */
  "routes": [
    {
      "pattern": "admin.vibefinance-ai.com",
      "custom_domain": true
    }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  /*
    A service binding, not a URL — decision 0186.

    The same reasoning decision 0005 found the hard way: a plain
    fetch() to a Worker's own workers.dev URL is silently blocked by
    Cloudflare's anti-loop protections, and the request never arrives.
  */
  "services": [
    {
      "binding": "LICENCE_SERVICE",
      "service": "vf-licence"
    }
  ],

  "vars": {
    /*
      **The operator's own team domain.** Cloudflare Access verifies the
      identity and sets `Cf-Access-Authenticated-User-Email`; this
      Worker refuses anything without one.

      Not a secret: it is a hostname, and a reviewer should see which
      Access team guards the admin key.
    */
    "ACCESS_TEAM_DOMAIN": "not-configured.invalid"
  }
}
