{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vf-licence",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // A separate database from every vf-app instance, by design (see
  // docs/decisions/0001-worker-split-and-tenant-resolution.md): this
  // Worker must never be reachable from a customer's bindings, and no
  // customer content may ever cross into it — only cross-customer
  // control-plane data (customers, licences, usage counts).
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "vf-licence-poc",
      "database_id": "3590272c-fa73-4052-bab7-4491352c2410"
    }
  ],

  // The licence expiry sweep (decision 0039) — this Worker's first
  // scheduled trigger. Blocks every licence whose valid_to has
  // passed, which is what actually ends a 30-day trial: vf-app's
  // licence cache fails open at its last known good state (decision
  // 0003), so a licence that merely stops being renewable never
  // stops anything on its own.
  //
  // Hourly rather than daily: the cost is a single indexed query
  // against a small table, and it bounds how long an expired trial
  // can keep working to an hour rather than most of a day. The exact
  // interval is easy to change and nothing depends on its precise
  // value.
  "triggers": {
    "crons": ["0 * * * *"]
  }

  // ADMIN_API_KEY (protects POST /customers, POST /licences, key
  // rotation) is deliberately not declared here — it's a secret, set
  // via `wrangler secret put ADMIN_API_KEY`, generated by
  // scripts/generate-admin-key.mjs, never a plain var and never
  // committed. See docs/decisions/0006-endpoint-authentication.md.
}
