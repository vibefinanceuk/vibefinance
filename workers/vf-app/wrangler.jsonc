{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vf-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Today's tenant-resolution shape (route 1, see
  // docs/decisions/0001-worker-split-and-tenant-resolution.md): one
  // deployment per customer, each with its own binding. This file is the
  // per-customer variable — every other customer's wrangler.jsonc differs
  // only in `database_id` (and eventually `database_name`), never in
  // application code. Nothing in src/ may reference this binding except
  // shared/tenant.ts.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vf-app-poc",
      "database_id": "7cac2188-4fce-46e1-a555-2b2ac852f494"
    }
  ],

  // The NL-to-rule compiler (Blueprint build order step 2). See
  // docs/decisions/0002-compiler-model-choice.md and
  // src/compiler-model.ts. Workers AI usage incurs real cost per
  // request once deployed — unlike D1, there's no free local
  // equivalent, so this has never been invoked from this session.
  "ai": {
    "binding": "AI"
  },

  // The licensing contract (Blueprint build order step 4, "Subsystem
  // three"). See docs/decisions/0003-licensing-signed-token.md.
  //
  // LICENCE_SIGNING_PUBLIC_KEY is a genuine nested JSON object, not a
  // JSON string pasted in as text. This matters: an earlier version of
  // this file stored the key as an escaped string, which is exactly
  // the kind of thing that's easy to get subtly wrong by hand — and
  // once actually did, when a mistakenly-pasted PRIVATE key (which
  // does have a `d` field the public key lacks) went out as a plain,
  // non-secret var. Cloudflare's own docs confirm `vars` supports real
  // JSON objects directly, delivered to the Worker already parsed
  // (env.LICENCE_SIGNING_PUBLIC_KEY is a JS object, not a string
  // needing JSON.parse() — see src/index.ts's isPublicKeyJwk()). Paste
  // the public key's JWK fields directly below, unescaped, exactly as
  // scripts/generate-licence-keypair.mjs prints them.
  //
  // Not sensitive either way — the corresponding private key never
  // leaves vf-licence — so this is a plain var, not a secret.
  //
  // CUSTOMER_ID and ENVIRONMENT_ID are deliberately two separate vars
  // (decision 0037), because they answer two genuinely different
  // questions:
  //   - CUSTOMER_ID must match `customers.id` in vf-licence. It is
  //     the *storage* identity — the R2 object key prefix,
  //     {customer}/{year}/{invoice_id}.{ext} (decision 0013). Keeping
  //     it customer-scoped means a document's own key stays stable
  //     and meaningful, and an R2 bucket is already per-deployment so
  //     the key has no need to re-encode which environment wrote it.
  //   - ENVIRONMENT_ID must match `environments.id` in vf-licence
  //     (e.g. "Acme-production", "Acme-sandbox" — decision 0036). It
  //     is the *entitlement and reporting* identity: which specific
  //     deployment is fetching its licence token and pushing its
  //     usage. A customer's sandbox and production deployments have
  //     separate licences and separate usage figures, so neither call
  //     can be made with a bare customer id any more.
  //
  // LICENCE_SERVER_URL is wherever that vf-licence instance actually
  // lives. LOCALE governs the genuinely customer-facing subset of API
  // messages — see docs/decisions/0008-locale-aware-messages.md and
  // src/i18n.ts for the full supported set (en, de, fr, es, it, nl);
  // any unset or unrecognised value falls back to English, never an
  // error.
  "vars": {
    "LICENCE_SIGNING_PUBLIC_KEY": {
      "key_ops": [
        "verify"
      ],
      "ext": true,
      "kty": "EC",
      "x": "g3VUG-jdiWnb9yvOq86rzAkvcE0efLnP02zpEQqkDPI",
      "y": "hOJTk34XXAqTKod8t_98LHbchzbmDSZeHaVY3V16Gac",
      "crv": "P-256"
    },
    "LICENCE_SERVER_URL": "https://vf-licence.vibefinance.workers.dev",
    "CUSTOMER_ID": "Acme",
    "ENVIRONMENT_ID": "Acme-production",
    "LOCALE": "en"
  },

  // Worker-to-Worker calls to vf-licence go through this Service
  // Binding, not a plain fetch() to vf-licence's workers.dev URL —
  // confirmed live that the latter silently 404s (Cloudflare blocks a
  // Worker fetching another Worker's workers.dev URL as an anti-loop
  // measure; the request never even reaches the target Worker). See
  // docs/decisions/0005-service-binding.md and src/index.ts's
  // LICENCE_SERVICE comment. `service` names the target Worker exactly
  // as it's deployed (`name` in vf-licence's own wrangler.jsonc) — this
  // only works because both Workers are in the same Cloudflare account.
  "services": [
    {
      "binding": "LICENCE_SERVICE",
      "service": "vf-licence"
    }
  ],

  // VF_LICENCE_API_KEY is deliberately not declared here — it's a
  // secret, this customer's own key for vf-licence's per-customer
  // endpoints, set via `wrangler secret put VF_LICENCE_API_KEY` using
  // the plaintext shown once at customer creation or last rotation.
  // Unlike LICENCE_SIGNING_PUBLIC_KEY above, this genuinely is
  // sensitive — never a var, never committed. See
  // docs/decisions/0006-endpoint-authentication.md.

  // The scheduled refresh — src/index.ts's scheduled() handler is the
  // only place this Worker calls out to vf-licence; fetch() never does
  // ("no network call in the hot path", Blueprint). Every 6 hours is
  // arbitrary and easy to change — the token's own default 48h
  // lifetime (workers/vf-licence/src/token-route.ts) is what actually
  // bounds how stale the cached state can get if a run or two is
  // missed.
  "triggers": {
    "crons": ["0 */6 * * *"]
  },

  // R2 document retention (decision 0013, 0035). One bucket per
  // customer, mirroring the per-customer D1 database above — genuine
  // data-sovereignty isolation, the same reasoning as decision 0011.
  // The bucket itself must be created first — this session has no
  // Cloudflare credentials to do that:
  //   npx wrangler r2 bucket create <a-real-name-for-this-customer> \
  //     [--jurisdiction=eu|fedramp|us]   # see decision 0033 — optional,
  //                                       # only if this customer's own
  //                                       # org_profiles.r2_jurisdiction
  //                                       # is set to one of these
  // Then replace the placeholder below with the real bucket name.
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "acme-documents"
    }
  ]
}
