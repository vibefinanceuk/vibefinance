{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vf-ui",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  // Static files, served by Cloudflare before the Worker runs. Only one
  // asset collection is possible per Worker, and by default a matching
  // file wins over the Worker script — which is what we want: HTML, CSS
  // and JavaScript are files, and the Worker exists only to inject
  // configuration and to answer what no file matches.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Paths the Worker must see BEFORE the asset layer.
    //
    // `/config.js` is generated per deployment rather than shipped.
    // `/api/*` is the backend-for-frontend (decision 0102) — sign-in,
    // sign-out, and the proxied calls that carry the session cookie.
    //
    // Without listing `/api/*` these reach the Worker only by falling
    // through the asset layer when nothing matches. That may work, and
    // relying on a fall-through is the wrong shape when Cloudflare
    // documents this exact case: `run_worker_first: ["/api/*"]` is
    // their own example for a Worker serving an API alongside a
    // single-page application.
    "run_worker_first": ["/config.js", "/api/*"]
  },

  "vars": {
    // Where the APIs live — deployment configuration, deliberately NOT
    // baked into the JavaScript (decision 0099). Moving to a custom
    // domain later is then a config change rather than a UI rebuild,
    // and both origins can run at once during a transition.
    "LICENCE_API": "https://vf-licence.vibefinance.workers.dev"
  },

  "observability": { "enabled": true }
}
